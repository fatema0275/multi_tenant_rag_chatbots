# ============================================================
# SiteMind Crawl Service — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# --- Database (Supabase Postgres) ---
# Use the pooled connection URL for the crawl service workers.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct URL (bypasses PgBouncer — needed for DDL/migrations)
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
FLASK_PORT=8001

# --- Crawl tuning (all have code-level defaults) ---
CRAWL_REQUEST_DELAY=1.5        # seconds between requests to same domain
CRAWL_MAX_WORKERS=3            # max concurrent Celery threads per job
CRAWL_MAX_DEPTH=5              # BFS max depth (sitemap fallback)
CRAWL_MAX_PAGES=500            # hard cap on URLs per crawl job
CRAWL_PAGE_TIMEOUT=15          # per-page HTTP timeout in seconds
CRAWL_MIN_TEXT_LENGTH=200      # chars below which Playwright is used

# --- User-Agent ---
CRAWL_USER_AGENT=SiteMind-Crawler/1.0 (+https://sitemind.ai/bot)
