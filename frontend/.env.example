# ─── SiteMind Frontend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in values before running the dev server.
# NEVER commit .env to version control.

# Base URL of the Express REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: override the Vite dev server port (default: 3000)
# VITE_PORT=3000

